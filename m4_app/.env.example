# Laptop 1 environment variables (set by scripts/start_laptop1.ps1; listed here for reference)
M4_MODE=trained
M4_TEAM_PREDICTOR=m3_hmm.inference:predict_trip
# Folder of evaluator trips: <trip_id>/<trip_id>.track|.nodes|.arcs|.route  (default: <repo>/data/evaluator_test)
M4_EVAL_DIR=../data/evaluator_test
M4_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
M4_LOG_PATH=logs/requests.jsonl
M4_MAX_POINTS=50000
M4_MAX_ARCS=1000000
